# Dependencies
**/node_modules/

# Build and test outputs
**/dist/
**/build/
**/target/
**/.vite/
**/coverage/
**/.nyc_output/
*.tsbuildinfo

# Local environment files and secrets
.env
.env.*
!.env.example
!**/.env.example
!backend/.env.vnpay.local.example
!backend/.env.mysql.local.example
!frontend-web/.env.development
!frontend-web/.env.production
