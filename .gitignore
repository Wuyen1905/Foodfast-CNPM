backend/.env.mysql.local

# Runtime data and uploaded evidence
backend/runtime-data/
/backend/data/
*.mv.db
*.trace.db
*.lock.db
**/complaint-evidence/

# Logs and temporary files
*.log
logs/
tmp/
temp/
.tmp*/
*.tmp
**/check-log.txt
/allfiles.txt

# Local analysis and generated working artifacts
analysis/
artifacts/
diagnostics/
.publish/

# Old local copies that are not part of the published project
/src/
/web/
/tools/
/node_modules/

# Keep the published repository root intentionally small. Files and folders
# outside this allow-list are legacy notes, local helpers, or generated work.
/*
!/.github/
!/.gitattributes
!/.gitignore
!/README.md
!/backend/
!/docs/
!/frontend-web/
!/run_all.bat
!/run_all.sh
!/start-foodfast-vnpay.ps1

