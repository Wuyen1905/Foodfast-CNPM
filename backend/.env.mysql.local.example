# Copy this file to .env.mysql.local for local development.
# Never commit the real password.
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/foodfast_dev?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&sslMode=DISABLED
spring.datasource.username=foodfast_app
spring.datasource.password=replace-with-local-password
